@page
@model GestionProduits.Pages.Categories.IndexModel
@{ ViewData["Title"] = "Gestion des Catégories"; }

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1"><i class="bi bi-tags text-primary me-2"></i>Liste des Catégories</h1>
            <p class="text-muted mb-0">Organisez vos produits par familles.</p>
        </div>
        <a asp-page="Create" class="btn btn-primary shadow-sm px-4 py-2 rounded-pill">
            <i class="bi bi-plus-lg me-2"></i>Nouvelle Catégorie
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 text-muted">
                    <tr>
                        <th class="py-3 ps-4">Nom de la catégorie</th>
                        <th class="py-3 text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">
                                <i class="bi bi-folder2-open text-warning me-2"></i>@c.Nom
                            </td>
                            <td class="text-end pe-4">
                                <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-light text-primary me-1 rounded-pill px-3">
                                    <i class="bi bi-pencil"></i> Modifier
                                </a>
                                <a asp-page="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-light text-danger rounded-pill px-3">
                                    <i class="bi bi-trash"></i> Supprimer
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>