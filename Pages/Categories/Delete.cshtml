@page "{id:int}"
@model GestionProduits.Pages.Categories.DeleteModel
@{ ViewData["Title"] = "Supprimer la catégorie"; }

<h1>Supprimer la catégorie</h1>

<h3>Êtes-vous sûr de vouloir supprimer cette catégorie ?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Categorie.Nom)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Categorie.Nom)</dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Categorie.Id" />
        <button type="submit" class="btn btn-danger">Supprimer</button> |
        <a asp-page="Index" class="btn btn-secondary">Retour à la liste</a>
    </form>
</div>