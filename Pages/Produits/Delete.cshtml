@page "{id:int}"
@model GestionProduits.Pages.Produits.DeleteModel
@{ ViewData["Title"] = "Supprimer le produit"; }

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 border-top border-danger border-4">
                <div class="card-body p-4 p-md-5 text-center">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex p-3 mb-3 fs-3">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <h2 class="fw-bold text-dark mb-2">Êtes-vous sûr ?</h2>
                    <p class="text-muted mb-4">Cette action est irréversible. Voulez-vous vraiment supprimer cet élément ?</p>

                    <div class="bg-light p-3 rounded-3 text-start mb-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Nom :</dt>
                            <dd class="col-sm-8 fw-semibold text-dark mb-1">@Model.Produit.Nom</dd>
                            
                            <dt class="col-sm-4 text-muted">Prix :</dt>
                            <dd class="col-sm-8 text-success fw-bold mb-1">@Model.Produit.Prix.ToString("C")</dd>

                            <dt class="col-sm-4 text-muted">Stock :</dt>
                            <dd class="col-sm-8 text-dark mb-0">@Model.Produit.Stock unités</dd>
                        </dl>
                    </div>
                    
                    <form method="post">
                        <input type="hidden" asp-for="Produit.Id" />
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-page="Index" class="btn btn-light text-secondary px-4 py-2 rounded-pill fw-semibold">
                                Annuler
                            </a>
                            <button type="submit" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold shadow-sm">
                                <i class="bi bi-trash me-1"></i> Oui, supprimer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>