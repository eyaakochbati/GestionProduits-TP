@page
@model GestionProduits.Pages.Produits.IndexModel
@{ ViewData["Title"] = "Gestion des Produits"; }

<div class="container py-4">
    <!-- En-tête avec titre et bouton d'ajout -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1"><i class="bi bi-box-seam text-primary me-2"></i>Catalogue des Produits</h1>
            <p class="text-muted mb-0">Gérez vos stocks, prix et catégories en toute simplicité.</p>
        </div>
        <a asp-page="Create" class="btn btn-primary shadow-sm px-4 py-2 rounded-pill">
            <i class="bi bi-plus-lg me-2"></i>Nouveau Produit
        </a>
    </div>

    <!-- Barre de recherche et Statistiques en cartes -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <form method="get" class="w-100">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 ps-3 rounded-start-pill text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="SearchString" value="@Model.SearchString" class="form-control bg-light border-0 py-2" placeholder="Rechercher un produit par son nom..." />
                            <button type="submit" class="btn btn-primary px-4 rounded-end-pill">Filtrer</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-white-50 small mb-1">STOCK TOTAL</h6>
                        <h4 class="fw-bold mb-0">@Model.TotalStock</h4>
                    </div>
                    <div class="fs-2 text-white-50"><i class="bi bi-stack"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-success text-white h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-white-50 small mb-1">PRIX MOYEN</h6>
                        <h4 class="fw-bold mb-0">@Model.PrixMoyen.ToString("C")</h4>
                    </div>
                    <div class="fs-2 text-white-50"><i class="bi bi-tag"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau moderne -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 text-muted">
                    <tr>
                        <th class="py-3 ps-4">Nom</th>
                        <th class="py-3">Catégorie</th>
                        <th class="py-3">Prix</th>
                        <th class="py-3">Stock</th>
                        <th class="py-3 text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Produits.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i> Aucun produit trouvé.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Produits)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@item.Nom</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                        @(item.Categorie?.Nom ?? "Aucune")
                                    </span>
                                </td>
                                <td class="fw-bold text-success">@item.Prix.ToString("C")</td>
                                <td>
                                    <span class="@(item.Stock < 5 ? "text-danger fw-bold" : "text-dark")">
                                        @item.Stock unités
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary me-1 rounded-pill px-3">
                                        <i class="bi bi-pencil"></i> Modifier
                                    </a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger rounded-pill px-3">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>